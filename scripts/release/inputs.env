# Pinned inputs of the release backend (G182). build-backend.sh downloads each
# once into its cache and refuses a file whose sha256 differs. Bump a pin by
# changing its URL and hash together.

# CPython 3.12 for macOS arm64, python-build-standalone (the same builds uv
# installs; relocatable, sqlite built with loadable extensions for sqlite-vec).
PBS_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-aarch64-apple-darwin-install_only_stripped.tar.gz"
PBS_SHA256="ad8d0c637c0a36b967b310e2c07254f4d2ca8cabaa7699e55ed6290aceb481a2"

# Portable, relocatable git for macOS arm64: dugite-native, the build GitHub
# Desktop ships. Git is GPLv2; the build adds git's COPYING and a source pointer.
GIT_URL="https://github.com/desktop/dugite-native/releases/download/v2.53.0-4/dugite-native-v2.53.0-4098283-macOS-arm64.tar.gz"
GIT_SHA256="f9dc64635a5b62fbd7ad95db73268bbb8912255ac516d65d37bf7af22fcb8ffe"
GIT_VERSION="2.53.0"
GIT_COPYING_URL="https://raw.githubusercontent.com/git/git/v2.53.0/COPYING"
GIT_COPYING_SHA256="5b2198d1645f767585e8a88ac0499b04472164c0d2da22e75ecf97ef443ab32e"

# The bundled embedding model: intfloat/multilingual-e5-small (MIT, 384 dimensions,
# ungated, ~100 languages), as the int8 ONNX export Transformers.js publishes —
# 113 MB model + 16 MB tokenizer. Owner 2026-10-06: multilingual over the English-only
# bge-small (34 MB), which missed every Spanish query against English notes in a
# spot check where this model found all six. Pinned to a revision; each file is checked.
MODEL_ID="intfloat/multilingual-e5-small"
MODEL_DIR_NAME="multilingual-e5-small"
MODEL_REPO="Xenova/multilingual-e5-small"
MODEL_REVISION="761b726dd34fb83930e26aab4e9ac3899aa1fa78"
# Where MODEL_FILES are read from, and the manifest the embedder reads (api/services/onnx_embedder.py).
# scripts/fetch-embedding-model.sh is the one reader of this block: the release build and a
# developer checkout (`make embedding-model`) fetch the same bytes.
MODEL_BASE_URL="https://huggingface.co/$MODEL_REPO/resolve/$MODEL_REVISION"
MODEL_SOURCE="https://huggingface.co/$MODEL_REPO/tree/$MODEL_REVISION"
MODEL_LICENSE="MIT (intfloat/multilingual-e5-small)"
MODEL_DIMENSIONS=384
MODEL_POOLING="mean"
MODEL_MAX_TOKENS=512
MODEL_QUERY_PREFIX="query: "
MODEL_DOCUMENT_PREFIX="passage: "
MODEL_FILES="onnx/model_quantized.onnx:model.onnx:f80102d3f2a1229f387d3c81909990d8945513e347b0eab049f7de3c6f98c193
tokenizer.json:tokenizer.json:0b44a9d7b51c3c62626640cda0e2c2f70fdacdc25bbbd68038369d14ebdf4c39
config.json:config.json:cb99455288675345e1a4f411438d5d0adbba5fbd3a67ea4fb03c015433b996c1"
