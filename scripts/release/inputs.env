# Pinned inputs of the release backend (G182). build-backend.sh downloads each
# once into its cache and refuses a file whose sha256 differs. Bump a pin by
# changing its URL and hash together.

# CPython 3.12 for macOS arm64, python-build-standalone (the same builds uv
# installs; relocatable, sqlite built with loadable extensions for sqlite-vec).
PBS_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-aarch64-apple-darwin-install_only_stripped.tar.gz"
PBS_SHA256="ad8d0c637c0a36b967b310e2c07254f4d2ca8cabaa7699e55ed6290aceb481a2"

# Portable, relocatable git for macOS arm64: dugite-native, the build GitHub
# Desktop ships. Git is GPLv2; the build adds git's COPYING and a source pointer.
GIT_URL="https://github.com/desktop/dugite-native/releases/download/v2.53.0-4/dugite-native-v2.53.0-4098283-macOS-arm64.tar.gz"
GIT_SHA256="f9dc64635a5b62fbd7ad95db73268bbb8912255ac516d65d37bf7af22fcb8ffe"
GIT_VERSION="2.53.0"
GIT_COPYING_URL="https://raw.githubusercontent.com/git/git/v2.53.0/COPYING"
GIT_COPYING_SHA256="5b2198d1645f767585e8a88ac0499b04472164c0d2da22e75ecf97ef443ab32e"

# The bundled embedding model: BAAI/bge-small-en-v1.5 (MIT, 384 dimensions,
# ungated), as the int8 ONNX export Transformers.js publishes — 34 MB against
# 133 MB for fp32, cosine 0.997 to the fp32 vectors on a spot check, same
# ranking. Pinned to a revision; each file is checked.
MODEL_ID="BAAI/bge-small-en-v1.5"
MODEL_DIR_NAME="bge-small-en-v1.5"
MODEL_REPO="Xenova/bge-small-en-v1.5"
MODEL_REVISION="ea104dacec62c0de699686887e3f920caeb4f3e3"
MODEL_FILES="onnx/model_quantized.onnx:model.onnx:6c9c6101a956d62dfb5e7190c538226c0c5bb9cb27b651234b6df063ee7dbfe4
tokenizer.json:tokenizer.json:d241a60d5e8f04cc1b2b3e9ef7a4921b27bf526d9f6050ab90f9267a1f9e5c66
config.json:config.json:fa73f90bf92c8cace1fbcb709626306f2bdbc9ea3e5b5f94b440df9b6aa56350"
