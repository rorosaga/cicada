# Python bytecode
__pycache__/
*.pyc

# Personal conversation exports — never commit
data/
# G138: the recommended-skill catalog is reviewed public data, not an export.
# Only that one file is re-included; anything else dropped in api/data/ stays ignored.
!/api/data/
/api/data/*
!/api/data/recommended_skills.json

# Raw chat-export corpus used to consolidate the memory graph (claude/gemini/openai).
# ~200MB of personal conversations; kept local for source-grounded re-consolidation
# and provenance review, never committed.
cicada-data/

# Memory runtime data is a separate git repo
memory/
memory_backup/

# Thesis benchmark outputs (raw answers, scoring sheets, workspace metadata)
benchmark_results/

# Benchmark inputs that contain personal content
benchmarks/*.local.*
benchmarks/questions.yaml
benchmarks/queries.txt

# macOS Finder
.DS_Store

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/
.worktrees/

# launchd backend service logs
logs/
