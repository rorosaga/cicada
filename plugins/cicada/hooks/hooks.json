{
  "description": "Cicada: Stop saves the session (G105); PreCompact and SessionEnd flush the same capture (G110 gate A); SessionStart and UserPromptSubmit add what Cicada remembers (G149).",
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cicada-hook capture --harness claude-code", "timeout": 5}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cicada-hook capture --harness claude-code", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cicada-hook capture --harness claude-code", "timeout": 5}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cicada-hook recall --harness claude-code", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/cicada-hook recall --harness claude-code", "timeout": 5}]}
    ]
  }
}
