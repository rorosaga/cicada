CICADA_MEMORY_PATH=/path/to/cicada/memory

# Embedding backend for the search index.
#   local      -> on this Mac (default). With `make embedding-model` run once, the
#                 release app's own small multilingual ONNX model (no torch, no key);
#                 without it, EmbeddingGemma through sentence-transformers.
#   openai     -> text-embedding-3-small (needs OPENAI_API_KEY, paid)
#   openrouter -> a hosted model through OpenRouter (needs OPENROUTER_API_KEY, paid)
# A paid mode with no key falls back to local. A bank remembers the model its index
# was built with; changing it rebuilds the index (it is derived and disposable).
CICADA_EMBEDDING_MODE=local

# Model to use for Sleep cycle (litellm format: provider/model)
# Examples: gpt-5.4-mini, openai/gpt-4o-mini, anthropic/claude-sonnet-4-20250514, gemini/gemini-2.0-flash
CICADA_LITELLM_MODEL=gpt-5.4-mini

# Optional dedicated model for Stage 2 same/different/unsure disambiguation.
# Defaults to gpt-5.4-nano if omitted.
CICADA_LITELLM_DISAMBIGUATION_MODEL=gpt-5.4-nano

# LiteLLM reads these standard env vars automatically — set whichever you use
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key
